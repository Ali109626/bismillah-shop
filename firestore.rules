rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products Collection:
    // - Everyone (public/customers) can READ products
    // - Only authenticated admin can CREATE, UPDATE, or DELETE products and change stock
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Orders Collection:
    // - Anyone can CREATE a new order from storefront checkout
    // - Only authenticated admin can READ, UPDATE status, or DELETE orders
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Receipts Collection:
    // - Only authenticated admin can view and manage digital receipts
    match /receipts/{receiptId} {
      allow read, write: if request.auth != null;
    }
    
    // Default fallback: deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
