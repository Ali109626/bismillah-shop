rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Settings Collection:
    // Stores admin password (settings/admin -> adminPassword) and store configurations
    // Must be readable and writable across devices without third-party auth
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Products Collection:
    // Catalog items, pricing, and stock count
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Orders Collection:
    // Customer online orders from storefront checkout
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // Receipts Collection:
    // Digital POS & online order receipts
    match /receipts/{receiptId} {
      allow read, write: if true;
    }
    
    // Fallback: allow all documents during store operation
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
